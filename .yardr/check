#!/bin/sh
gate_slot=$HOME/ws_yardr/integrations/gate-slot.sh
if [ -z "${YARD_GATE_SLOT_HELD:-}" ] && [ -f "$gate_slot" ]; then exec sh "$gate_slot" -- sh "$0" "$@"; fi
# The depot's test command, the merge gate of rig aiquokka: yardr runs it in a
# bead's worktree before hand-on and at landing, and a bead lands only when it
# exits 0. yardr reads this file from the base branch (origin/main), so an edit
# here counts once it has landed there.
set -e
# On bead runs, first check that the branch carries commits past its base and
# nothing is left uncommitted (yd-wkjq). Quiet runs on the base have no bead.
if [ -n "${YARDR_BEAD:-}" ]; then
  sh /Users/bsaladin/ws_yardr/integrations/bin/branch-ready.sh "${YARDR_BASE:-origin/main}" HEAD .
fi
go vet ./... && go test ./...
